PORT=8050
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/vaultpad?appName=ClusterName&authSource=admin&retryWrites=true&w=majority
NODE_ENV=development

# ── Google OAuth Credentials ──────────────────────────────────────────────────
# 1. Go to https://console.cloud.google.com
# 2. Create / select a project
# 3. APIs & Services → Credentials → Create OAuth 2.0 Client ID
# 4. Application type: Web application
# 5. Authorized redirect URIs:
#    - http://localhost:8050/auth/google/callback   (for local dev)
#    - https://YOUR-APP.onrender.com/auth/google/callback  (for production)
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID_HERE
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET_HERE
GOOGLE_CALLBACK_URL=http://localhost:8050/auth/google/callback

# ── Session Secret (use a long random string in production) ───────────────────
SESSION_SECRET=change-this-to-a-long-random-string-in-production
