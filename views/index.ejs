<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>VaultPad | Your Private Digital Vault</title>
    <meta name="description" content="VaultPad — Instantly spin up a secure, blazing-fast workspace for your notes, code, and media. No login required.">

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
    <!-- FontAwesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    colors: {
                        primary: { DEFAULT: '#2563EB', light: '#3B82F6', dark: '#1D4ED8' },
                    },
                    fontFamily: { sans: ['Inter', 'sans-serif'] },
                    animation: {
                        'fade-up': 'fadeUp 0.7s ease forwards',
                        'float':   'float 6s ease-in-out infinite',
                    }
                }
            }
        }
    </script>

    <!-- Custom CSS + FOUC prevention -->
    <link rel="stylesheet" href="/css/custom.css">

    <style>
        /* ── Theme variables ──────────────────────────────────────────── */
        :root {
            --bg-main:    #F0F4FF;
            --bg-card:    #FFFFFF;
            --bg-sidebar: #F8FAFF;
            --text-primary:   #0F172A;
            --text-secondary: #475569;
            --text-muted:     #94A3B8;
            --border:    #E2E8F0;
            --primary:   #2563EB;
            --shadow-xl: 0 20px 60px rgba(0,0,0,.12);
        }
        html.dark {
            --bg-main:    #0A0F1E;
            --bg-card:    #111827;
            --bg-sidebar: #0D1526;
            --text-primary:   #F1F5F9;
            --text-secondary: #94A3B8;
            --text-muted:     #64748B;
            --border:    #1E293B;
            --shadow-xl: 0 20px 60px rgba(0,0,0,.45);
        }

        /* ── Smooth colour transitions on ALL elements ─────────────────── */
        *, *::before, *::after {
            transition: background-color .35s ease, border-color .35s ease, color .25s ease;
            box-sizing: border-box;
        }

        body { font-family: 'Inter', sans-serif; background: var(--bg-main); color: var(--text-primary); }

        /* ── Floating blobs ───────────────────────────────────────────── */
        .blob {
            position: absolute; border-radius: 50%;
            filter: blur(60px); pointer-events: none; z-index: 0;
        }
        .blob-1 { width:520px;height:520px; background:rgba(37,99,235,.18);  top:-10%; left:-8%;  animation: floatBlob 10s ease-in-out infinite; }
        .blob-2 { width:420px;height:420px; background:rgba(147,51,234,.14); bottom:-8%;right:-6%; animation: floatBlob 13s ease-in-out infinite reverse; }
        .blob-3 { width:280px;height:280px; background:rgba(56,189,248,.16);  top:40%;  right:14%; animation: floatBlob 9s ease-in-out infinite 2s; }

        @keyframes floatBlob {
            0%,100% { transform: translateY(0)   rotate(0deg); }
            50%      { transform: translateY(-28px) rotate(6deg); }
        }

        /* ── Hero mockup container ────────────────────────────────────── */
        .mockup-window {
            background: var(--bg-card);
            border: 1px solid var(--border);
            border-radius: 18px;
            box-shadow: var(--shadow-xl), 0 0 0 1px rgba(255,255,255,.04);
            overflow: hidden;
            position: relative;
        }
        .mockup-titlebar {
            height: 38px;
            background: var(--bg-sidebar);
            border-bottom: 1px solid var(--border);
            display: flex; align-items: center; padding: 0 16px; gap: 8px;
        }
        .dot { width:12px;height:12px;border-radius:50%; }
        .dot-r { background:#FF5F57; } .dot-y { background:#FFBD2E; } .dot-g { background:#28CA41; }

        /* ── Feature card hover ───────────────────────────────────────── */
        .feature-card {
            background: var(--bg-card); border: 1px solid var(--border);
            border-radius: 16px; padding: 2rem;
            transition: transform .3s ease, box-shadow .3s ease, border-color .3s ease !important;
        }
        .feature-card:hover {
            transform: translateY(-8px);
            box-shadow: 0 24px 48px rgba(37,99,235,.12);
            border-color: rgba(37,99,235,.3);
        }

        /* ── Theme toggle button ─────────────────────────────────────── */
        .theme-btn {
            width: 40px; height: 40px; border-radius: 50%;
            display: flex; align-items: center; justify-content: center;
            background: var(--bg-main); border: 1px solid var(--border);
            color: var(--text-secondary); cursor: pointer;
            font-size: 15px;
            transition: background .25s, border-color .25s, color .2s, transform .2s !important;
        }
        .theme-btn:hover { color: var(--primary); transform: rotate(15deg) scale(1.12); }

        /* ── Input focus glow ────────────────────────────────────────── */
        .vault-input { outline: none; background: transparent; border: none; }
        .vault-input:focus { box-shadow: none; }

        /* ── Toast ───────────────────────────────────────────────────── */
        .toast { animation: toastIn .3s ease; }
        @keyframes toastIn { from { opacity:0; transform:translateY(12px); } to { opacity:1; transform:translateY(0); } }

        /* ── Animate fade up ─────────────────────────────────────────── */
        @keyframes fadeUp { from { opacity:0; transform:translateY(28px); } to { opacity:1; transform:translateY(0); } }
        .anim-1 { opacity:0; animation: fadeUp .8s ease .1s forwards; }
        .anim-2 { opacity:0; animation: fadeUp .8s ease .3s forwards; }
        .anim-3 { opacity:0; animation: fadeUp .8s ease .5s forwards; }

        /* ── Navbar scroll shadow ────────────────────────────────────── */
        nav { transition: box-shadow .3s; }
        nav.scrolled { box-shadow: 0 4px 24px rgba(0,0,0,.08); }
        html.dark nav.scrolled { box-shadow: 0 4px 24px rgba(0,0,0,.3); }

        /* ── Mockup image ────────────────────────────────────────────── */
        .hero-img { width:100%; height:100%; object-fit:cover; display:block; }

        /* ── Step connector line  ────────────────────────────────────── */
        .step-line { background: var(--border); }

        /* ── Theme toggle icon colours ─────────────────────────────── */
        html:not(.dark) [data-theme-icon] { color: #6366f1; }  /* indigo moon  */
        html.dark        [data-theme-icon] { color: #f59e0b; }  /* amber  sun   */

        /* ── Override Chrome autofill background ─────────────────────── */
        input:-webkit-autofill,
        input:-webkit-autofill:hover,
        input:-webkit-autofill:focus {
            -webkit-box-shadow: 0 0 0 1000px var(--bg-card) inset !important;
            -webkit-text-fill-color: var(--text-primary) !important;
            caret-color: var(--text-primary);
            transition: background-color 9999s ease;
        }

        /* Custom scrollbar */
        ::-webkit-scrollbar { width:5px; } ::-webkit-scrollbar-thumb { background:var(--border); border-radius:10px; }
    </style>
</head>

<!--  Apply theme BEFORE paint to prevent flash  -->
<script>
    (function(){
        var saved = localStorage.getItem('vp-theme');
        var sysDark = window.matchMedia('(prefers-color-scheme:dark)').matches;
        var theme = saved || (sysDark ? 'dark' : 'light');
        if(theme === 'dark') document.documentElement.classList.add('dark');
        document.documentElement.setAttribute('data-theme', theme);
    })();
</script>

<body class="antialiased overflow-x-hidden">

<!-- ═══════════════════════ NAVBAR ═══════════════════════════════════════ -->
<nav id="navbar" class="fixed w-full z-50 bg-white dark:bg-slate-900 border-b border-gray-200 dark:border-slate-800"
     style="box-shadow:0 1px 4px rgba(0,0,0,.06);">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex justify-between items-center h-16">

            <!-- Logo -->
            <div class="flex items-center gap-2.5 cursor-pointer select-none">
                <div class="w-8 h-8 rounded-lg bg-gradient-to-br from-blue-500 to-blue-700 flex items-center justify-center text-white font-extrabold text-lg shadow-lg shadow-blue-500/30">V</div>
                <span class="font-bold text-[19px] tracking-tight text-slate-900 dark:text-white">VaultPad</span>
            </div>

            <!-- Desktop nav -->
            <div class="hidden md:flex items-center gap-6">
                <a href="#features"    class="text-sm font-medium text-slate-600 dark:text-slate-300 hover:text-slate-900 dark:hover:text-white transition-colors">Features</a>
                <a href="#how-it-works" class="text-sm font-medium text-slate-600 dark:text-slate-300 hover:text-slate-900 dark:hover:text-white transition-colors">How it Works</a>
                <a href="https://github.com/cherry2695/VaultPad-Secure-Code-File-Storage-Platform" target="_blank" rel="noopener noreferrer" class="text-slate-500 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white transition-colors">
                    <i class="fa-brands fa-github text-xl"></i>
                </a>

                <!-- Theme toggle -->
                <button id="theme-toggle" data-theme-btn class="theme-btn" aria-label="Toggle theme">
                    <i id="theme-icon" data-theme-icon class="fa-solid fa-moon"></i>
                </button>

                <!-- Auth button (conditional) -->
                <% if (locals.user) { %>
                <div class="flex items-center gap-3">
                    <img src="<%= user.avatar %>" alt="<%= user.firstName %>" class="w-8 h-8 rounded-full border-2 border-blue-200" onerror="this.style.display='none'">
                    <span class="text-sm font-medium text-slate-700 dark:text-slate-200"><%= user.firstName %></span>
                    <form action="/auth/logout" method="POST" class="inline">
                        <button type="submit" class="text-sm text-slate-500 dark:text-slate-400 hover:text-red-500 transition-colors font-medium">Sign out</button>
                    </form>
                </div>
                <% } else { %>
                <a href="/auth/google" id="google-signin-btn" class="flex items-center gap-2 border border-gray-200 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-700 dark:text-slate-200 px-4 py-2 rounded-full text-sm font-semibold hover:bg-gray-50 dark:hover:bg-slate-700 transition-all shadow-sm" style="transition:box-shadow .25s,transform .25s;">
                    <svg class="w-4 h-4" viewBox="0 0 24 24"><path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/><path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/><path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l3.66-2.84z"/><path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"/></svg>
                    Sign in with Google
                </a>
                <% } %>

                <a href="#cta-section" class="bg-primary hover:bg-blue-700 text-white text-sm px-5 py-2.5 rounded-full font-semibold transition-all shadow-md shadow-blue-500/25 hover:shadow-blue-500/40 hover:-translate-y-px">
                    Open Vault
                </a>
            </div>

            <!-- Mobile nav -->
            <div class="md:hidden flex items-center gap-3">
                <button id="theme-toggle-mobile" data-theme-btn class="theme-btn" aria-label="Toggle theme">
                    <i id="theme-icon-mobile" data-theme-icon class="fa-solid fa-moon"></i>
                </button>
                <button class="p-2 text-[var(--text-primary)]">
                    <i class="fa-solid fa-bars text-xl"></i>
                </button>
            </div>
        </div>
    </div>
</nav>

<!-- ═══════════════════════ HERO ══════════════════════════════════════════ -->
<section class="relative pt-28 pb-20 lg:pt-44 lg:pb-32 overflow-hidden" style="background:var(--bg-main);">
    <!-- Blobs -->
    <div class="blob blob-1"></div>
    <div class="blob blob-2"></div>
    <div class="blob blob-3"></div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">

            <!-- Left: Copy -->
            <div class="text-center lg:text-left">
                <div class="anim-1 inline-flex items-center gap-2 px-4 py-1.5 rounded-full border text-sm font-semibold mb-6"
                     style="background:rgba(37,99,235,.08);border-color:rgba(37,99,235,.25);color:#2563EB;">
                    <span class="w-2 h-2 rounded-full bg-blue-500 animate-pulse"></span>
                    Redefining private workspaces
                </div>

                <h1 class="anim-1 text-5xl lg:text-6xl xl:text-7xl font-extrabold tracking-tight leading-[1.08] mb-6 text-[var(--text-primary)]">
                    Your Private<br>
                    <span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-500 via-indigo-500 to-purple-600">
                        Digital Vault
                    </span>
                </h1>

                <p class="anim-2 text-lg text-[var(--text-secondary)] mb-10 max-w-lg mx-auto lg:mx-0 leading-relaxed">
                    Instantly spin up a secure, blazing-fast workspace for your notes, code, and media.
                    <strong class="text-[var(--text-primary)] font-semibold">Log in with Google to keep your vaults private.</strong>
                </p>

                <!-- Code entry box -->
                <div class="anim-2 max-w-md mx-auto lg:mx-0">
                    <div class="flex items-center bg-[var(--bg-card)] border border-[var(--border)] rounded-2xl shadow-xl p-1.5 focus-within:border-blue-500 focus-within:shadow-blue-500/15 focus-within:shadow-xl" style="transition:border-color .2s,box-shadow .2s;">
                        <span class="pl-3 pr-1 text-[var(--text-muted)]"><i class="fa-solid fa-lock text-sm"></i></span>
                        <input type="text" id="workspace-code"
                               name="vault-secret"
                               class="vault-input flex-1 px-3 py-3 text-[15px] text-[var(--text-primary)] placeholder-[var(--text-muted)]"
                               placeholder="Enter a secret code…"
                               autocomplete="new-password"
                               spellcheck="false"
                               data-lpignore="true"
                               data-form-type="other">
                        <button id="enter-workspace-btn"
                                class="bg-primary hover:bg-blue-700 text-white px-5 py-3 rounded-xl text-sm font-bold transition-all shadow-md shadow-blue-500/30 flex items-center gap-2 flex-shrink-0">
                            Enter <i class="fa-solid fa-arrow-right text-xs"></i>
                        </button>
                    </div>
                    <p id="workspace-error" class="hidden text-red-500 text-xs mt-2 pl-2">Code must be at least 3 characters.</p>
                    <% if (locals.user) { %>
                    <p class="text-xs text-[var(--text-muted)] mt-3 pl-2">
                        <i class="fa-solid fa-shield-halved mr-1"></i> 100% private · Google Auth Secured · Auto-saves everything
                    </p>
                    <% } else { %>
                    <a href="/auth/google" class="inline-flex items-center gap-2 mt-3 pl-2 text-xs text-blue-600 dark:text-blue-400 font-semibold hover:underline">
                        <svg class="w-3.5 h-3.5" viewBox="0 0 24 24"><path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/><path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/><path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l3.66-2.84z"/><path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"/></svg>
                        Sign in with Google to access your private vault
                    </a>
                    <% } %>
                </div>
            </div>

            <!-- Right: Mockup -->
            <div class="anim-3 relative hidden lg:block">
                <!-- Glow ring behind window -->
                <div class="absolute -inset-6 bg-gradient-to-tr from-blue-500/20 via-purple-500/10 to-cyan-500/15 rounded-3xl blur-3xl"></div>

                <div class="mockup-window relative z-10">
                    <!-- Title bar -->
                    <div class="mockup-titlebar">
                        <div class="dot dot-r"></div>
                        <div class="dot dot-y"></div>
                        <div class="dot dot-g"></div>
                        <div class="flex-1 flex justify-center">
                            <div class="px-3 py-0.5 rounded text-xs text-[var(--text-muted)] bg-[var(--bg-main)] border border-[var(--border)] font-mono">
                                VaultPad — workspace
                            </div>
                        </div>
                    </div>

                    <!-- Preview Image (full bleed) -->
                    <div class="w-full" style="height:380px;overflow:hidden;">
                        <img src="/img/Security.png"
                             alt="VaultPad secure workspace preview"
                             class="hero-img"
                             loading="eager">
                    </div>

                    <!-- Bottom status bar -->
                    <div class="px-4 py-2 border-t border-[var(--border)] flex items-center justify-between text-xs text-[var(--text-muted)]" style="background:var(--bg-sidebar);">
                        <span class="flex items-center gap-1.5">
                            <span class="w-2 h-2 rounded-full bg-green-400 animate-pulse inline-block"></span>
                            Auto-saved · just now
                        </span>
                        <span class="font-mono">Python · 42 lines</span>
                    </div>
                </div>

                <!-- Floating badge -->
                <div class="absolute -bottom-5 -left-6 bg-[var(--bg-card)] border border-[var(--border)] rounded-2xl px-4 py-3 shadow-xl flex items-center gap-3 z-20">
                    <div class="w-9 h-9 rounded-xl bg-green-100 dark:bg-green-900/30 flex items-center justify-center text-green-600">
                        <i class="fa-solid fa-cloud-arrow-up text-sm"></i>
                    </div>
                    <div>
                        <div class="text-xs font-bold text-[var(--text-primary)]">Auto-saved</div>
                        <div class="text-[11px] text-[var(--text-muted)]">All changes synced</div>
                    </div>
                </div>

                <!-- Floating badge 2 -->
                <div class="absolute -top-5 -right-4 bg-[var(--bg-card)] border border-[var(--border)] rounded-2xl px-4 py-3 shadow-xl flex items-center gap-3 z-20">
                    <div class="w-9 h-9 rounded-xl bg-blue-100 dark:bg-blue-900/30 flex items-center justify-center text-blue-600">
                        <i class="fa-solid fa-lock text-sm"></i>
                    </div>
                    <div>
                        <div class="text-xs font-bold text-[var(--text-primary)]">End-to-end</div>
                        <div class="text-[11px] text-[var(--text-muted)]">bcrypt encrypted</div>
                    </div>
                </div>
            </div>

        </div>
    </div>
</section>

<!-- ═══════════════════════ STATS ══════════════════════════════════════════ -->
<section class="py-12 border-y border-[var(--border)]" style="background:var(--bg-card);">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-2 lg:grid-cols-4 gap-8">
            <div class="text-center">
                <div class="text-3xl font-extrabold text-[var(--text-primary)] mb-1">&lt;10ms</div>
                <div class="text-sm text-[var(--text-secondary)] font-medium">Response Time</div>
            </div>
            <div class="text-center">
                <div class="text-3xl font-extrabold text-[var(--text-primary)] mb-1 flex items-center justify-center gap-2">
                    <svg class="w-8 h-8" viewBox="0 0 24 24"><path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/><path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/><path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l3.66-2.84z"/><path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"/></svg>
                </div>
                <div class="text-sm text-[var(--text-secondary)] font-medium">Secure Sign-In</div>
            </div>
            <div class="text-center">
                <div class="text-3xl font-extrabold text-[var(--text-primary)] mb-1">100%</div>
                <div class="text-sm text-[var(--text-secondary)] font-medium">Private</div>
            </div>
            <div class="text-center">
                <div class="text-3xl font-extrabold text-[var(--text-primary)] mb-1">∞</div>
                <div class="text-sm text-[var(--text-secondary)] font-medium">Workspaces</div>
            </div>
        </div>
    </div>
</section>

<!-- ═══════════════════════ FEATURES ══════════════════════════════════════ -->
<section id="features" class="py-28" style="background:var(--bg-main);">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center max-w-2xl mx-auto mb-20">
            <p class="text-sm font-semibold text-blue-500 tracking-widest uppercase mb-3">Features</p>
            <h2 class="text-4xl md:text-5xl font-extrabold text-[var(--text-primary)] mb-5 leading-tight">Everything you need,<br>nothing you don't</h2>
            <p class="text-lg text-[var(--text-secondary)] leading-relaxed">A powerful suite of tools seamlessly integrated into a beautiful, distraction-free environment.</p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            <div class="feature-card">
                <div class="w-12 h-12 rounded-2xl bg-blue-100 dark:bg-blue-900/30 text-blue-600 flex items-center justify-center text-xl mb-5 shadow-sm">
                    <i class="fa-solid fa-cloud-arrow-up"></i>
                </div>
                <h3 class="text-lg font-bold mb-2 text-[var(--text-primary)]">Auto Save</h3>
                <p class="text-[var(--text-secondary)] text-sm leading-relaxed">Never lose a thought. Every keystroke is automatically saved in real-time as you type.</p>
