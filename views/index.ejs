<!-- Toast Container -->
<div id="toast-container" class="fixed bottom-4 right-4 z-50 flex flex-col gap-2 pointer-events-none"></div>

<!-- ═══════════════════════ SCRIPTS ═══════════════════════════════════════ -->
<script>
// ══════════════════════════════════════════════════════════════
//  THEME TOGGLE — Self-contained, robust, no external dependency
// ══════════════════════════════════════════════════════════════
(function () {
    'use strict';

    var STORAGE_KEY = 'vp-theme';

    function getTheme() {
        return localStorage.getItem(STORAGE_KEY) ||
               (window.matchMedia('(prefers-color-scheme:dark)').matches ? 'dark' : 'light');
    }

    function applyTheme(theme) {
        var html = document.documentElement;
        if (theme === 'dark') {
            html.classList.add('dark');
        } else {
            html.classList.remove('dark');
        }
        html.setAttribute('data-theme', theme);
        localStorage.setItem(STORAGE_KEY, theme);

        // Update ALL toggle icons
        document.querySelectorAll('[data-theme-icon]').forEach(function (icon) {
            icon.className = theme === 'dark' ? 'fa-solid fa-sun' : 'fa-solid fa-moon';
        });
    }

    function toggle() {
        applyTheme(getTheme() === 'dark' ? 'light' : 'dark');
    }

    // Apply on load (also done in <script> in <head>, this syncs icons after DOM ready)
    document.addEventListener('DOMContentLoaded', function () {
        applyTheme(getTheme());

        document.querySelectorAll('[data-theme-btn]').forEach(function (btn) {
            btn.addEventListener('click', toggle);
        });
    });

    // Expose globally so workspace.js can call ThemeManager.setTheme()
    window.ThemeManager = { setTheme: applyTheme, toggle: toggle, getTheme: getTheme };
})();

// ══════════════════════════════════════════════════════════════
//  TOAST
// ══════════════════════════════════════════════════════════════
window.showToast = function (message, type) {
    var container = document.getElementById('toast-container');
    if (!container) return;
    var colors = { success:'#22c55e', error:'#ef4444', info:'#3b82f6' };
    var icons  = { success:'fa-circle-check', error:'fa-circle-exclamation', info:'fa-circle-info' };
    var t = type || 'info';
    var toast = document.createElement('div');
    toast.className = 'toast pointer-events-auto flex items-center gap-3 px-4 py-3 rounded-xl border shadow-lg min-w-[240px]';
    toast.style.cssText = 'background:var(--bg-card);border-color:var(--border);';
    toast.innerHTML = '<i class="fa-solid ' + (icons[t]||icons.info) + '" style="color:' + (colors[t]||colors.info) + '"></i>' +
                      '<span style="font-size:13px;font-weight:500;color:var(--text-primary);flex:1">' + message + '</span>';
    container.appendChild(toast);
    setTimeout(function () {
        toast.style.transition = 'opacity .3s, transform .3s';
        toast.style.opacity = '0'; toast.style.transform = 'translateY(8px)';
        setTimeout(function () { toast.remove(); }, 320);
    }, 3500);
};

// ══════════════════════════════════════════════════════════════
//  AUTH STATE (injected from server)
// ══════════════════════════════════════════════════════════════
var VAULTPAD_SIGNED_IN      = <%- locals.user          ? 'true' : 'false' %>;
var VAULTPAD_OAUTH_READY    = <%- locals.oauthConfigured ? 'true' : 'false' %>;

// ══════════════════════════════════════════════════════════════
//  WORKSPACE ENTRY
// ══════════════════════════════════════════════════════════════
async function enterVault(code, btn) {
    var trimmed = (code || '').trim();
    if (trimmed.length < 3) {
        var err = document.getElementById('workspace-error');
        if (err) { err.classList.remove('hidden'); setTimeout(function(){ err.classList.add('hidden'); }, 3000); }
        return;
    }

    // ── Client-side auth gate (runs BEFORE any API call) ─────────
    if (!VAULTPAD_SIGNED_IN) {
        // Pulse the Sign-in button to draw attention
        var signinBtn = document.getElementById('google-signin-btn');
        if (signinBtn) {
            signinBtn.style.boxShadow = '0 0 0 4px rgba(59,130,246,.45)';
            signinBtn.style.transform = 'scale(1.06)';
            setTimeout(function() {
                signinBtn.style.boxShadow = '';
                signinBtn.style.transform = '';
            }, 2200);
            signinBtn.scrollIntoView({ behavior: 'smooth', block: 'center' });
        }

        if (!VAULTPAD_OAUTH_READY) {
            showToast('⚙️ Google OAuth credentials not configured yet. See setup guide.', 'error');
        } else {
            showToast('🔒 Please sign in with Google first to open your vault!', 'info');
        }
        return;   // Stop here — do NOT hit the API
    }

    var orig = btn.innerHTML;
    btn.innerHTML = '<i class="fa-solid fa-circle-notch fa-spin"></i> Entering…';
    btn.disabled = true;

    try {
        var res  = await fetch('/api/workspace/enter', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ code: trimmed })
        });
        var data = await res.json();

        if (res.status === 401) {
            sessionStorage.setItem('vp-pending-code', trimmed);
            window.location.href = '/auth/google';
            return;
        }

        if (data.success) {
            showToast(data.data.isNew ? '🎉 New vault created!' : '✅ Welcome back!', 'success');
            setTimeout(function () { window.location.href = '/workspace/' + data.data.workspaceId; }, 600);
        } else {
            throw new Error(data.message || 'Failed');
        }
    } catch (e) {
        btn.innerHTML = orig; btn.disabled = false;
        showToast(e.message || 'Could not connect. Try again.', 'error');
    }
}


document.addEventListener('DOMContentLoaded', function () {
    // Hero entry
    var hi = document.getElementById('workspace-code');
    var hb = document.getElementById('enter-workspace-btn');
    if (hb) hb.addEventListener('click', function(){ enterVault(hi.value, hb); });
    if (hi) hi.addEventListener('keypress', function(e){ if(e.key==='Enter') enterVault(hi.value, hb); });

    // CTA entry
    var ci = document.getElementById('workspace-code-bottom');
    var cb = document.getElementById('enter-workspace-btn-bottom');
    if (cb) cb.addEventListener('click', function(){ enterVault(ci.value, cb); });
    if (ci) ci.addEventListener('keypress', function(e){ if(e.key==='Enter') enterVault(ci.value, cb); });

    // ── Handle URL auth params from redirects ─────────────────────
    var urlParams = new URLSearchParams(window.location.search);
    var authParam  = urlParams.get('auth');

    if (authParam === 'success') {
        showToast('✅ Signed in with Google! Enter your vault code.', 'success');
        var pendingCode = sessionStorage.getItem('vp-pending-code');
        if (pendingCode) {
            sessionStorage.removeItem('vp-pending-code');
            if (hi) { hi.value = pendingCode; hi.focus(); }
            setTimeout(function() { if (hb) enterVault(pendingCode, hb); }, 900);
        }
        window.history.replaceState({}, '', '/');
    }
    if (authParam === 'required') {
        showToast('🔒 Sign in with Google to access your vault.', 'info');
        window.history.replaceState({}, '', '/');
    }
    if (authParam === 'failed') {
        showToast('❌ Google sign-in failed. Please try again.', 'error');
        window.history.replaceState({}, '', '/');
    }
    if (authParam === 'not-configured') {
        showToast('⚙️ Google OAuth not configured yet. Add your credentials to .env and restart.', 'error');
        window.history.replaceState({}, '', '/');
    }

    // Navbar scroll shadow
    var nav = document.getElementById('navbar');
    window.addEventListener('scroll', function() {
        nav && nav.classList.toggle('scrolled', window.scrollY > 12);
    });

    // Feature card scroll reveal
    var observer = new IntersectionObserver(function(entries) {
        entries.forEach(function(entry) {
            if (entry.isIntersecting) {
                entry.target.style.opacity  = '1';
                entry.target.style.transform = 'translateY(0)';
                observer.unobserve(entry.target);
            }
        });
    }, { threshold: 0.12 });
    document.querySelectorAll('.feature-card').forEach(function(card, i) {
        card.style.opacity = '0';
        card.style.transform = 'translateY(32px)';
        card.style.transition = 'opacity .55s ease ' + (i * 0.07) + 's, transform .55s ease ' + (i * 0.07) + 's, box-shadow .3s !important';
        observer.observe(card);
    });
});

</script>
</body>
