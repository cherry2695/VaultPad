<!DOCTYPE html>
<html lang="en" data-theme="<%= workspace.theme || 'light' %>">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= workspace.name || 'Untitled Workspace' %> | VaultPad</title>
    <!-- Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
    <!-- FontAwesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    colors: {
                        primary: { DEFAULT: '#2563EB', light: '#3B82F6', dark: '#1D4ED8' },
                        navy: '#0F172A',
                        slate: { bg: '#F0F4FF' }
                    },
                    fontFamily: {
                        sans: ['Inter', 'sans-serif'],
                        mono: ['JetBrains Mono', 'monospace']
                    }
                }
            }
        }
    </script>
    <!-- Highlight.js -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.9.0/styles/github-dark.min.css">
    <script src="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.9.0/highlight.min.js"></script>
    <!-- Custom CSS -->
    <link rel="stylesheet" href="/css/custom.css">
</head>
<body class="bg-[var(--bg-main)] text-[var(--text-primary)] overflow-hidden h-screen flex flex-col">
    <!-- App Container with Data Attributes -->
    <div id="app" data-workspace-id="<%= workspace._id %>" data-workspace-name="<%= workspace.name %>" data-workspace-theme="<%= workspace.theme %>" class="flex flex-col h-full w-full">
        
        <!-- Top Navbar -->
        <header class="h-14 bg-[var(--bg-card)] border-b border-[var(--border)] flex items-center justify-between px-4 shrink-0 z-20">
            <div class="flex items-center gap-4">
                <a href="/" class="flex items-center gap-2 text-[var(--text-primary)] hover:text-primary transition-colors">
                    <div class="w-6 h-6 rounded bg-primary flex items-center justify-center text-white font-bold text-xs">V</div>
                </a>
                
                <div class="h-4 w-px bg-[var(--border)]"></div>
                
                <div class="flex items-center gap-2 group cursor-pointer" id="workspace-name-container">
                    <h1 id="workspace-name-display" class="font-semibold text-[var(--text-primary)] group-hover:text-primary transition-colors truncate max-w-[200px]"><%= workspace.name || 'Workspace' %></h1>
                    <i class="fa-solid fa-pen text-xs text-[var(--text-muted)] opacity-0 group-hover:opacity-100 transition-opacity"></i>
                </div>
                <input type="text" id="workspace-name-input" class="hidden bg-[var(--bg-main)] border border-primary rounded px-2 py-1 text-sm text-[var(--text-primary)] outline-none" value="<%= workspace.name %>">
                
                <span class="badge bg-blue-100 text-blue-800 dark:bg-blue-900/30 dark:text-blue-300 text-xs px-2 py-0.5 rounded-full font-medium ml-2">Private</span>
            </div>
            
            <div class="flex items-center gap-3">
                <div id="save-status" class="text-xs text-[var(--text-muted)] font-medium flex items-center gap-1 opacity-0 transition-opacity duration-300 mr-2">
                    <i class="fa-solid fa-cloud-arrow-up"></i> <span>Saved</span>
                </div>
                
                <button id="search-btn" class="p-2 text-[var(--text-secondary)] hover:text-[var(--text-primary)] hover:bg-[var(--bg-main)] rounded-lg transition-colors flex items-center gap-2 text-sm border border-[var(--border)] px-3" title="Search (Ctrl+K)">
                    <i class="fa-solid fa-magnifying-glass"></i> <span class="hidden sm:inline">Search...</span> <kbd class="hidden sm:inline bg-[var(--bg-card)] border border-[var(--border)] px-1.5 rounded text-[10px] ml-2">Ctrl K</kbd>
                </button>
                
                <button id="theme-toggle-workspace" class="w-9 h-9 flex items-center justify-center text-[var(--text-secondary)] hover:text-[var(--text-primary)] hover:bg-[var(--bg-main)] rounded-lg transition-colors border border-[var(--border)]">
                    <i class="fa-solid fa-moon"></i>
                </button>
                
                <a href="/" class="w-9 h-9 flex items-center justify-center text-[var(--text-secondary)] hover:text-red-500 hover:bg-red-50 dark:hover:bg-red-900/20 rounded-lg transition-colors border border-[var(--border)]" title="Exit Workspace">
                    <i class="fa-solid fa-arrow-right-from-bracket"></i>
                </a>
                
                <button id="mobile-menu-btn" class="md:hidden w-9 h-9 flex items-center justify-center text-[var(--text-secondary)] hover:text-[var(--text-primary)] hover:bg-[var(--bg-main)] rounded-lg transition-colors border border-[var(--border)]">
                    <i class="fa-solid fa-bars"></i>
                </button>
            </div>
        </header>

        <!-- Main Layout -->
        <div class="flex flex-1 overflow-hidden relative">
            
            <!-- Left Sidebar -->
            <aside id="sidebar" class="w-64 bg-[var(--bg-sidebar)] border-r border-[var(--border)] flex flex-col shrink-0 transition-transform duration-300 absolute md:relative z-10 h-full -translate-x-full md:translate-x-0">
                <div class="flex-1 overflow-y-auto py-4 custom-scrollbar">
                    
                    <!-- Pinned -->
                    <div class="mb-6 px-3">
                        <div class="text-xs font-semibold text-[var(--text-muted)] uppercase tracking-wider mb-2 px-2 flex items-center gap-2">
                            <i class="fa-solid fa-thumbtack"></i> Pinned
                        </div>
                        <ul id="sidebar-pinned-list" class="space-y-0.5">
                            <!-- Populated by JS -->
                        </ul>
                    </div>
                    
                    <!-- Favorites -->
                    <div class="mb-6 px-3">
                        <div class="text-xs font-semibold text-[var(--text-muted)] uppercase tracking-wider mb-2 px-2 flex items-center gap-2">
                            <i class="fa-solid fa-star"></i> Favorites
                        </div>
                        <ul id="sidebar-favorites-list" class="space-y-0.5">
                            <!-- Populated by JS -->
                        </ul>
                    </div>
                    
                    <!-- Recent -->
                    <div class="mb-6 px-3">
                        <div class="text-xs font-semibold text-[var(--text-muted)] uppercase tracking-wider mb-2 px-2 flex items-center gap-2">
                            <i class="fa-solid fa-clock"></i> Recent
                        </div>
                        <ul id="sidebar-recent-list" class="space-y-0.5">
                            <!-- Populated by JS -->
                        </ul>
                    </div>
                </div>
                
                <!-- Bottom Actions -->
                <div class="p-4 border-t border-[var(--border)] space-y-1 bg-[var(--bg-sidebar)]">
                    <button id="trash-btn" class="w-full text-left px-3 py-2 rounded-lg text-sm text-[var(--text-secondary)] hover:text-[var(--text-primary)] hover:bg-[var(--bg-main)] transition-colors flex items-center gap-3">
                        <i class="fa-solid fa-trash-can w-4 text-center"></i> Trash
                    </button>
                    <button id="settings-btn" class="w-full text-left px-3 py-2 rounded-lg text-sm text-[var(--text-secondary)] hover:text-[var(--text-primary)] hover:bg-[var(--bg-main)] transition-colors flex items-center gap-3">
                        <i class="fa-solid fa-gear w-4 text-center"></i> Settings
                    </button>
                </div>
            </aside>
            
            <!-- Mobile Sidebar Overlay -->
            <div id="sidebar-overlay" class="fixed inset-0 bg-black/50 z-0 hidden md:hidden"></div>

            <!-- Main Content Area -->
            <main class="flex-1 flex flex-col min-w-0 bg-[var(--bg-main)] relative">
                
                <!-- Category Tabs -->
                <div class="h-12 border-b border-[var(--border)] bg-[var(--bg-card)] flex items-center px-2 overflow-x-auto no-scrollbar shrink-0 tab-bar">
                    <!-- Text Categories -->
                    <button class="tab-btn active" data-category="notes"><i class="fa-solid fa-note-sticky mr-1.5 text-yellow-500"></i> Notes</button>
                    <div class="w-px h-4 bg-[var(--border)] mx-1"></div>
                    <button class="tab-btn" data-category="python"><i class="fa-brands fa-python mr-1.5 text-blue-500"></i> Python</button>
                    <button class="tab-btn" data-category="java"><i class="fa-brands fa-java mr-1.5 text-red-500"></i> Java</button>
                    <button class="tab-btn" data-category="cpp"><i class="fa-solid fa-c mr-1.5 text-blue-700"></i> C++</button>
                    <button class="tab-btn" data-category="sql"><i class="fa-solid fa-database mr-1.5 text-gray-500"></i> SQL</button>
                    <button class="tab-btn" data-category="javascript"><i class="fa-brands fa-js mr-1.5 text-yellow-400"></i> JS</button>
                    <button class="tab-btn" data-category="html"><i class="fa-brands fa-html5 mr-1.5 text-orange-500"></i> HTML</button>
                    <button class="tab-btn" data-category="css"><i class="fa-brands fa-css3-alt mr-1.5 text-blue-400"></i> CSS</button>
                    <div class="w-px h-4 bg-[var(--border)] mx-1"></div>
                    <!-- Media Categories -->
                    <button class="tab-btn" data-category="images"><i class="fa-regular fa-image mr-1.5 text-green-500"></i> Images</button>
                    <button class="tab-btn" data-category="videos"><i class="fa-solid fa-video mr-1.5 text-purple-500"></i> Videos</button>
                    <button class="tab-btn" data-category="pdf"><i class="fa-solid fa-file-pdf mr-1.5 text-red-600"></i> PDF</button>
                    <button class="tab-btn" data-category="excel"><i class="fa-solid fa-file-excel mr-1.5 text-green-600"></i> Excel</button>
                    <button class="tab-btn" data-category="word"><i class="fa-solid fa-file-word mr-1.5 text-blue-600"></i> Word</button>
                    <button class="tab-btn" data-category="audio"><i class="fa-solid fa-music mr-1.5 text-pink-500"></i> Audio</button>
                </div>

                <!-- Content Panels Container -->
                <div class="flex-1 overflow-hidden relative" id="content-container">
                    
                    <!-- Text/Code Panel (Shared Layout) -->
                    <div id="text-panel" class="absolute inset-0 flex h-full transition-opacity duration-300">
                        <!-- Note List -->
                        <div class="w-72 border-r border-[var(--border)] bg-[var(--bg-card)] flex flex-col shrink-0">
                            <div class="p-3 border-b border-[var(--border)] flex gap-2">
                                <button id="new-note-btn" class="flex-1 bg-primary hover:bg-primary-dark text-white rounded-lg py-2 text-sm font-medium transition-colors flex items-center justify-center gap-2">
                                    <i class="fa-solid fa-plus"></i> New Note
                                </button>
                            </div>
                            <div class="px-3 py-2 border-b border-[var(--border)]">
                                <div class="relative">
                                    <i class="fa-solid fa-search absolute left-2.5 top-2.5 text-[var(--text-muted)] text-xs"></i>
                                    <input type="text" id="list-search-input" placeholder="Filter notes..." class="w-full bg-[var(--bg-main)] border border-[var(--border)] rounded-md pl-8 pr-3 py-1.5 text-sm focus:outline-none focus:border-primary transition-colors text-[var(--text-primary)]">
                                </div>
                            </div>
                            <div id="note-list-container" class="flex-1 overflow-y-auto custom-scrollbar p-2 space-y-1">
                                <!-- Populated by JS -->
                                <div class="text-center text-[var(--text-muted)] text-sm py-10">Loading notes...</div>
                            </div>
                        </div>

                        <!-- Editor Area -->
                        <div class="flex-1 flex flex-col bg-[var(--bg-main)] min-w-0 relative">
                            <!-- Empty State -->
                            <div id="editor-empty-state" class="absolute inset-0 flex flex-col items-center justify-center bg-[var(--bg-main)] z-10">
                                <div class="w-24 h-24 bg-[var(--bg-card)] rounded-full flex items-center justify-center mb-4 shadow-sm border border-[var(--border)] text-3xl text-[var(--text-muted)]">
                                    <i class="fa-solid fa-pen-nib"></i>
                                </div>
                                <h3 class="text-xl font-semibold text-[var(--text-primary)] mb-2">No note selected</h3>
                                <p class="text-[var(--text-secondary)] text-sm mb-6 max-w-md text-center">Select a note from the list or create a new one to start writing.</p>
                                <button class="btn-primary px-6 py-2 rounded-lg text-sm font-medium shadow-sm" onclick="document.getElementById('new-note-btn').click()">
                                    Create New Note
                                </button>
                            </div>

                            <!-- Active Editor -->
                            <div id="editor-active-state" class="flex-1 flex flex-col h-full hidden">
                                <!-- Editor Toolbar -->
                                <div class="h-14 border-b border-[var(--border)] bg-[var(--bg-card)] flex items-center justify-between px-6 shrink-0">
                                    <input type="text" id="note-title-input" class="text-xl font-bold bg-transparent border-none focus:outline-none text-[var(--text-primary)] placeholder-[var(--text-muted)] flex-1 mr-4" placeholder="Note Title">
                                    
                                    <div class="flex items-center gap-1">
                                        <span id="note-stats" class="text-xs text-[var(--text-muted)] mr-4 hidden md:block">0 words | 0 chars</span>
                                        <span id="language-badge" class="badge bg-gray-100 text-gray-700 dark:bg-gray-800 dark:text-gray-300 text-xs px-2 py-1 rounded-md font-mono hidden mr-2"></span>
                                        
                                        <button id="btn-pin" class="p-2 text-[var(--text-secondary)] hover:text-primary rounded-md transition-colors tooltip" data-tip="Pin note">
                                            <i class="fa-solid fa-thumbtack"></i>
                                        </button>
                                        <button id="btn-favorite" class="p-2 text-[var(--text-secondary)] hover:text-yellow-500 rounded-md transition-colors tooltip" data-tip="Favorite">
                                            <i class="fa-regular fa-star"></i>
                                        </button>
                                        <div class="w-px h-4 bg-[var(--border)] mx-1"></div>
                                        <button id="btn-history" class="p-2 text-[var(--text-secondary)] hover:text-primary rounded-md transition-colors tooltip" data-tip="Version History">
                                            <i class="fa-solid fa-clock-rotate-left"></i>
                                        </button>
                                        <button id="btn-reading-mode" class="p-2 text-[var(--text-secondary)] hover:text-primary rounded-md transition-colors tooltip" data-tip="Reading Mode">
                                            <i class="fa-solid fa-book-open"></i>
                                        </button>
                                        <button id="btn-copy-code" class="p-2 text-[var(--text-secondary)] hover:text-primary rounded-md transition-colors tooltip hidden" data-tip="Copy Code">
                                            <i class="fa-regular fa-copy"></i>
                                        </button>
                                        <div class="w-px h-4 bg-[var(--border)] mx-1"></div>
                                        <button id="btn-delete-note" class="p-2 text-[var(--text-secondary)] hover:text-red-500 rounded-md transition-colors tooltip" data-tip="Delete Note">
                                            <i class="fa-solid fa-trash-can"></i>
                                        </button>
                                    </div>
                                </div>
                                
                                <!-- Editor Body -->
                                <div class="flex-1 relative flex overflow-hidden bg-[var(--bg-main)]">
                                    <!-- Line numbers gutter -->
                                    <div id="editor-gutter" class="w-12 bg-[var(--bg-card)] border-r border-[var(--border)] text-right pr-2 py-4 text-xs font-mono text-[var(--text-muted)] opacity-50 select-none overflow-hidden shrink-0">
                                        <!-- Numbers injected by JS -->
                                    </div>
                                    
                                    <!-- The actual textarea -->
                                    <textarea id="note-content-input" class="flex-1 w-full h-full p-4 resize-none bg-transparent border-none focus:outline-none text-[var(--text-primary)] text-base leading-relaxed font-sans custom-scrollbar" placeholder="Start typing..."></textarea>
                                    
                                    <!-- Syntax highlighting overlay for code (hidden for notes) -->
                                    <pre id="code-highlight-overlay" class="absolute inset-0 p-4 pointer-events-none hidden m-0 opacity-0"><code class="hljs"></code></pre>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Files Panel (Media Categories) -->
                    <div id="files-panel" class="absolute inset-0 flex flex-col h-full opacity-0 pointer-events-none transition-opacity duration-300 bg-[var(--bg-main)]">
                        
                        <!-- Toolbar & Upload -->
                        <div class="p-4 border-b border-[var(--border)] bg-[var(--bg-card)] flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 shrink-0">
                            <div>
                                <h2 id="files-category-title" class="text-xl font-bold capitalize">Images</h2>
                                <p class="text-sm text-[var(--text-secondary)]">Manage your uploaded files here</p>
                            </div>
                            
                            <div class="w-full sm:w-auto">
                                <label for="file-upload-input" class="btn-primary w-full sm:w-auto px-4 py-2 rounded-lg text-sm font-medium cursor-pointer shadow-sm flex items-center justify-center gap-2 hover:bg-primary-dark transition-colors">
                                    <i class="fa-solid fa-cloud-arrow-up"></i> Upload File
                                </label>
                                <input type="file" id="file-upload-input" class="hidden" multiple>
                            </div>
                        </div>
                        
                        <!-- Upload Dropzone Overlay -->
                        <div id="upload-dropzone" class="absolute inset-0 bg-primary/10 backdrop-blur-sm border-4 border-dashed border-primary z-20 flex flex-col items-center justify-center hidden">
                            <i class="fa-solid fa-cloud-arrow-up text-6xl text-primary mb-4 animate-bounce"></i>
                            <h3 class="text-2xl font-bold text-primary">Drop files to upload</h3>
                            <p class="text-[var(--text-primary)] mt-2">Supports multiple files</p>
                        </div>
                        
                        <!-- Files Content Area -->
                        <div class="flex-1 overflow-y-auto custom-scrollbar p-6 relative">
                            <!-- Loading / Empty states -->
                            <div id="files-loading-state" class="absolute inset-0 flex items-center justify-center bg-[var(--bg-main)] z-10">
                                <div class="w-8 h-8 border-4 border-primary border-t-transparent rounded-full animate-spin"></div>
                            </div>
                            
                            <div id="files-empty-state" class="absolute inset-0 flex flex-col items-center justify-center bg-[var(--bg-main)] z-10 hidden">
                                <div class="w-20 h-20 rounded-full bg-[var(--bg-card)] border-2 border-dashed border-[var(--border)] flex items-center justify-center mb-6">
                                    <i class="fa-solid fa-plus text-3xl text-[var(--text-muted)]"></i>
                                </div>
                                <h3 class="text-xl font-semibold text-[var(--text-primary)] mb-2">No files yet</h3>
                                <p class="text-[var(--text-secondary)] text-sm mb-6 max-w-md text-center">Drag and drop files here or click the upload button to add media.</p>
                                <button class="btn-primary px-6 py-2 rounded-lg text-sm font-medium shadow-sm" onclick="document.getElementById('file-upload-input').click()">
                                    Select Files
                                </button>
                            </div>
                            
                            <!-- Grids/Lists for files (rendered by JS) -->
                            <div id="files-grid-container" class="file-grid hidden"></div>
                            <div id="files-list-container" class="file-list hidden"></div>
                        </div>
                    </div>

                </div>
            </main>
        </div>
    </div>

    <!-- Global Search Modal -->
    <div id="search-modal" class="fixed inset-0 bg-black/60 backdrop-blur-sm z-50 flex items-start justify-center pt-20 hidden opacity-0 transition-opacity duration-200">
        <div class="bg-[var(--bg-card)] w-full max-w-2xl rounded-xl shadow-2xl border border-[var(--border)] overflow-hidden transform scale-95 transition-transform duration-200" id="search-modal-content">
            <div class="p-4 border-b border-[var(--border)] flex items-center relative">
                <i class="fa-solid fa-magnifying-glass text-[var(--text-muted)] absolute left-7"></i>
                <input type="text" id="global-search-input" class="w-full bg-transparent border-none pl-10 pr-4 py-2 text-lg focus:outline-none text-[var(--text-primary)]" placeholder="Search notes and files...">
                <kbd class="hidden sm:inline bg-[var(--bg-main)] border border-[var(--border)] px-2 py-1 rounded text-xs text-[var(--text-muted)] ml-2 absolute right-4">ESC</kbd>
            </div>
            <div class="max-h-[60vh] overflow-y-auto custom-scrollbar p-2" id="search-results-container">
                <!-- Search results injected here -->
                <div class="py-12 text-center text-[var(--text-muted)]" id="search-placeholder">
                    Type to start searching across your entire vault...
                </div>
                <div class="py-12 text-center text-[var(--text-muted)] hidden" id="search-loading">
                    <i class="fa-solid fa-circle-notch fa-spin text-2xl text-primary mb-3"></i>
                    <p>Searching...</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Version History Drawer -->
    <div id="version-history-drawer" class="fixed inset-y-0 right-0 w-80 bg-[var(--bg-card)] border-l border-[var(--border)] shadow-2xl z-40 transform translate-x-full transition-transform duration-300 flex flex-col">
        <div class="p-4 border-b border-[var(--border)] flex justify-between items-center bg-[var(--bg-sidebar)]">
            <h3 class="font-bold text-lg flex items-center gap-2"><i class="fa-solid fa-clock-rotate-left"></i> Version History</h3>
            <button class="close-drawer-btn text-[var(--text-secondary)] hover:text-[var(--text-primary)] p-1">
                <i class="fa-solid fa-times"></i>
            </button>
        </div>
        <div class="flex-1 overflow-y-auto custom-scrollbar p-4" id="version-list-container">
            <!-- Versions injected here -->
            <div class="text-center text-[var(--text-muted)] py-8">Loading versions...</div>
        </div>
    </div>
    
    <!-- Version Preview Modal -->
    <div id="version-preview-modal" class="fixed inset-0 bg-black/60 backdrop-blur-sm z-50 flex items-center justify-center p-4 hidden opacity-0 transition-opacity duration-200">
        <div class="bg-[var(--bg-card)] w-full max-w-4xl h-[80vh] rounded-xl shadow-2xl border border-[var(--border)] overflow-hidden flex flex-col">
            <div class="p-4 border-b border-[var(--border)] flex justify-between items-center bg-[var(--bg-sidebar)] shrink-0">
                <div>
                    <h3 class="font-bold text-lg">Version Preview</h3>
                    <p class="text-sm text-[var(--text-secondary)]" id="version-preview-date"></p>
                </div>
                <div class="flex items-center gap-3">
                    <button id="restore-version-btn" class="bg-primary hover:bg-primary-dark text-white px-4 py-2 rounded-lg text-sm font-medium transition-colors">
                        Restore This Version
                    </button>
                    <button class="close-modal-btn text-[var(--text-secondary)] hover:text-[var(--text-primary)] p-2 rounded-lg hover:bg-[var(--bg-main)]">
                        <i class="fa-solid fa-times"></i>
                    </button>
                </div>
            </div>
            <div class="flex-1 overflow-y-auto p-6 bg-[var(--bg-main)]">
                <div class="bg-[var(--bg-card)] border border-[var(--border)] rounded-lg p-6 shadow-sm min-h-full">
                    <h1 class="text-2xl font-bold mb-6 pb-2 border-b border-[var(--border)]" id="version-preview-title"></h1>
                    <div class="whitespace-pre-wrap font-sans text-[var(--text-primary)] leading-relaxed" id="version-preview-content"></div>
                </div>
            </div>
        </div>
    </div>

    <!-- Reading Mode Overlay -->
    <div id="reading-mode-overlay" class="fixed inset-0 bg-[var(--bg-main)] z-[60] overflow-y-auto hidden opacity-0 transition-opacity duration-300">
        <div class="max-w-3xl mx-auto px-6 py-16 relative min-h-screen">
            <button id="close-reading-mode" class="fixed top-6 right-6 w-10 h-10 bg-[var(--bg-card)] border border-[var(--border)] rounded-full shadow-md flex items-center justify-center text-[var(--text-secondary)] hover:text-[var(--text-primary)] hover:bg-[var(--bg-sidebar)] transition-colors z-10" title="Exit Reading Mode (ESC)">
                <i class="fa-solid fa-times"></i>
            </button>
            
            <div class="reading-content bg-[var(--bg-card)] p-10 md:p-16 rounded-2xl shadow-lg border border-[var(--border)]">
                <div class="flex items-center gap-2 text-sm text-[var(--text-muted)] mb-4 font-medium" id="reading-mode-meta"></div>
                <h1 class="text-4xl md:text-5xl font-extrabold mb-10 text-[var(--text-primary)] leading-tight" id="reading-mode-title">Title</h1>
                <div class="prose prose-lg dark:prose-invert max-w-none font-serif leading-relaxed text-[var(--text-primary)] whitespace-pre-wrap" id="reading-mode-content"></div>
            </div>
        </div>
    </div>

    <!-- Lightbox for Images -->
    <div id="lightbox-modal" class="fixed inset-0 bg-black/90 z-[70] flex items-center justify-center hidden opacity-0 transition-opacity duration-300">
        <button class="absolute top-6 right-6 text-white/70 hover:text-white p-2 text-2xl transition-colors close-lightbox-btn">
            <i class="fa-solid fa-times"></i>
        </button>
        <button class="absolute left-6 top-1/2 -translate-y-1/2 text-white/50 hover:text-white p-4 text-3xl transition-colors" id="lightbox-prev">
            <i class="fa-solid fa-chevron-left"></i>
        </button>
        <button class="absolute right-6 top-1/2 -translate-y-1/2 text-white/50 hover:text-white p-4 text-3xl transition-colors" id="lightbox-next">
            <i class="fa-solid fa-chevron-right"></i>
        </button>
        
        <div class="max-w-5xl max-h-[80vh] p-4 relative">
            <img id="lightbox-image" src="" alt="Full preview" class="max-w-full max-h-full object-contain rounded shadow-2xl mx-auto">
            <div class="absolute bottom-[-40px] left-0 right-0 text-center text-white/80" id="lightbox-caption"></div>
        </div>
    </div>
    
    <!-- Video Player Modal -->
    <div id="video-modal" class="fixed inset-0 bg-black/90 z-[70] flex items-center justify-center hidden opacity-0 transition-opacity duration-300">
        <button class="absolute top-6 right-6 text-white/70 hover:text-white p-2 text-2xl transition-colors close-modal-btn">
            <i class="fa-solid fa-times"></i>
        </button>
        <div class="w-full max-w-5xl px-4">
            <video id="modal-video-player" controls class="w-full rounded-lg shadow-2xl bg-black">
                <source src="" type="">
                Your browser does not support HTML video.
            </video>
            <div class="mt-4 text-center text-white/80" id="video-modal-title"></div>
        </div>
    </div>

    <!-- Toast Container -->
    <div id="toast-container" class="fixed bottom-4 right-4 z-[100] flex flex-col gap-2 pointer-events-none"></div>

    <!-- Scripts -->
    <script src="/js/theme.js"></script>
    <script src="/js/workspace.js"></script>
    <script src="/js/editor.js"></script>
    <script src="/js/fileManager.js"></script>
    <script src="/js/search.js"></script>
    <script>
        // Init everything when DOM is loaded
        document.addEventListener('DOMContentLoaded', () => {
            const workspaceId = document.getElementById('app').dataset.workspaceId;
            
            // Initialize managers if they exist
            if(window.WorkspaceManager) window.WorkspaceManager.init();
            if(window.EditorManager) window.EditorManager.init(workspaceId);
            if(window.FileManager) window.FileManager.init(workspaceId);
            if(window.SearchManager) window.SearchManager.init(workspaceId);
        });
    </script>
</body>
</html>
